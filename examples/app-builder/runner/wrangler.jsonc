// app-runner：執行 app-builder 產生的 app（和 app-builder 分開的程序與網域）
// 這裡沒有任何帳號、密鑰或 AI 金鑰；專案檔案透過 service binding 的 RPC 向 app-builder 拿
{
  "name": "app-runner",
  "main": "src/runner.js",
  "compatibility_date": "2025-11-01",
  "services": [{ "binding": "BUILDER", "service": "app-builder", "entrypoint": "Files" }],
  "durable_objects": { "bindings": [{ "name": "PROJECT_DB", "class_name": "ProjectDb" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectDb"] }]
}
