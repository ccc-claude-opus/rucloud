// app-builder：AI 網站產生器（rucloud 專用；Cloudflare 免費方案 10ms CPU 撐不起長串流）
{
  "name": "app-builder",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/apps/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "app-builder-db", "database_id": "local" }],
  "durable_objects": { "bindings": [{ "name": "PROJECT_DB", "class_name": "ProjectDb" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectDb"] }]
}
