// rucloud 支援的綁定一次示範：D1、KV、R2、Queues、Cron、Durable Objects、Vectorize、限流、service binding
{
  "name": "showcase",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "GREETING": "哈囉" },
  "d1_databases": [{ "binding": "DB", "database_name": "showcase-db", "database_id": "local" }],
  "kv_namespaces": [{ "binding": "KV", "id": "local" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "showcase-files" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "showcase-jobs" }],
    "consumers": [{ "queue": "showcase-jobs", "max_batch_size": 5, "max_batch_timeout": 1 }]
  },
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": { "bindings": [{ "name": "COUNTER", "class_name": "Counter" }] },
  "vectorize": [{ "binding": "VECTORS", "index_name": "showcase-index" }],
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "services": [{ "binding": "HELLO", "service": "hello" }]
}
